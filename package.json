{
  "name": "obsidian-context-cards",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Turn passages you read into editable English vocabulary cards with local Ollama and Anki.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:anki": "node scripts/verify-anki-core.mjs",
    "preview": "node scripts/preview.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write src tests scripts *.json *.mjs *.ts styles.css",
    "check": "npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:writing-anki": "node scripts/verify-writing-anki.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^27.0.0",
    "obsidian": "1.14.4",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
